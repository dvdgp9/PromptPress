RewriteEngine On

# storage/ nunca se sirve tal cual, salvo uploads/ (las imágenes del sitio).
# Cubre también carpetas que nacen sin su propio .htaccess, como updates/
# (copias de seguridad con config.php dentro). Este archivo lo despliega el
# actualizador, así que la protección llega también a instalaciones existentes.
RewriteRule ^storage/(?!uploads/) - [F,L]
# Y en uploads/ no se ejecuta nada.
RewriteRule ^storage/uploads/.+\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$ - [F,NC,L]

# Front controller: enviar todas las peticiones a index.php
# excepto archivos reales. Directorios como /admin/ también son rutas de app;
# sus assets se siguen sirviendo directamente porque sí son archivos reales.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# Bloquear acceso a archivos sensibles
<FilesMatch "^(\.htaccess|\.gitignore|\.gitkeep|composer\.(json|lock)|README\.md|.*\.sql|.*\.md)$">
    Require all denied
</FilesMatch>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Comprimir respuestas
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
